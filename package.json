{
  "name": "xemphim",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "realtime:dev": "tsx watch --env-file-if-exists=.env realtime/main.ts",
    "realtime:build": "esbuild realtime/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=realtime/dist/server.cjs --packages=external --alias:server-only=./test/stubs/server-only.ts",
    "realtime:start": "node --env-file-if-exists=.env realtime/dist/server.cjs",
    "worker:dev": "tsx watch --env-file-if-exists=.env worker/main.ts",
    "worker:build": "esbuild worker/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=worker/dist/worker.cjs --packages=external --alias:server-only=./test/stubs/server-only.ts",
    "worker:start": "node --env-file-if-exists=.env worker/dist/worker.cjs",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script",
    "db:deploy": "prisma migrate deploy",
    "db:init": "pnpm db:generate && pnpm db:deploy && pnpm db:seed",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "NODE_ENV=production tsx prisma/seed.ts",
    "db:purge": "tsx --tsconfig tsconfig.scripts.json scripts/purge-expired.ts",
    "gen:flutter": "tsx scripts/generate-flutter-client.ts",
    "postinstall": "prisma generate",
    "prepare": "husky || true"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.6",
      "deepmerge-ts": ">=8.0.0",
      "mysql2": ">=3.23.1"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@scalar/nextjs-api-reference": "^0.11.14",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/nodemailer": "^8.0.1",
    "aws4fetch": "1.0.20",
    "bullmq": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.7",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "nodemailer": "^9.1.1",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^6.2.0",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
