# Cấu hình cho pnpm. Chạy `npm` sẽ thấy cảnh báo "Unknown project config" —
# bỏ qua được: dự án dùng pnpm, và điều đó đã khoá bằng trường `packageManager`
# trong package.json.
#
# Hai dòng dưới đây RẤT CÓ THỂ trùng với mặc định của pnpm 8+. Vẫn giữ, vì viết
# rõ ra là khoá hành vi lại — bỏ đi là chuyển sang phụ thuộc một mặc định không
# ai ghi ở đâu, mà mặc định thì đổi được ở bản major sau.

# Tự cài peer dependency thay vì bắt khai báo lại bằng tay.
auto-install-peers=true

# Xung đột peer KHÔNG làm hỏng lệnh cài.
#
# ⚠️ Dòng này có hệ quả thật, không phải chỉnh cho im tiếng. Nó cần thiết vì hệ
# sinh thái React 19 còn nhiều thư viện chưa nới `peerDependencies`, để `true`
# thì `pnpm install` chết vì những xung đột vô hại. Đổi lại: xung đột THẬT cũng
# bị nuốt luôn.
#
# Gặp lỗi lạ sau khi nâng thư viện? Tạm đổi thành `true`, chạy `pnpm install`
# và đọc danh sách xung đột — thường thủ phạm nằm ngay trong đó.
strict-peer-dependencies=false