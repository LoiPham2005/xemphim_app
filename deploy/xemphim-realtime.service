# Máy chủ WebSocket — TIẾN TRÌNH RIÊNG với web.
#
# Vì sao cần unit riêng: `next start` là mô hình request/response, không giữ
# được kết nối lâu dài. Nhét socket vào Next bằng custom server sẽ phá
# `output: standalone`, và mỗi lần deploy web là rớt sạch kết nối đang mở.
# Tách ra thì deploy web không đụng tới người đang online.
#
# ⚠️ File này từng THIẾU. Ai deploy theo hướng systemd sẽ có web chạy bình
# thường nhưng KHÔNG có máy chủ WebSocket nào — không lỗi, không cảnh báo, chỉ
# là realtime im lặng không hoạt động. Đường Docker và PM2 đều có, chỉ systemd
# bỏ sót.
#
# ⚠️ DỰ ÁN KHÔNG DÙNG WEBSOCKET (`REALTIME_ENABLED=0`): tắt Ở TẦNG UNIT —
# `sudo systemctl disable --now xemphim-realtime` — chứ đừng chỉ sửa biến
# môi trường. Tiến trình có tự thoát kèm lời giải thích, nhưng `Restart=always`
# bật lại nó ngay. Nhớ xoá luôn khối `/socket.io/*` trong Caddyfile.
#
# Cài đặt:
#   sudo cp deploy/xemphim-realtime.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now xemphim-realtime
#
# Xem log:  journalctl -u xemphim-realtime -f

[Unit]
Description=xemphim realtime (Socket.IO)
After=network-online.target postgresql.service
Wants=network-online.target

# Dừng hẳn nếu crash liên tục, thay vì quay vòng vô tận che mất lỗi thật.
# Hai khoá này phải ở [Unit], KHÔNG phải [Service] — systemd đã chuyển chúng
# sang đây từ bản 229; đặt nhầm chỗ thì nó chỉ ghi "Unknown key name" rồi bỏ qua.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/xemphim

# Dùng chung file env với web. SESSION_SECRET BẮT BUỘC phải giống hệt: token do
# web/mobile cấp được verify ở đây, lệch một ký tự là mọi kết nối bị từ chối.
EnvironmentFile=/etc/xemphim/env
Environment=NODE_ENV=production
Environment=REALTIME_PORT=3002

# Bản build là một file duy nhất do esbuild gói lại (`pnpm realtime:build`),
# nên tiến trình này không cần node_modules của app.
ExecStart=/usr/bin/node realtime/dist/server.cjs

Restart=always
RestartSec=5

# Siết quyền giống unit web: một lỗ RCE không kéo theo quyền trên cả máy.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Chỉ cần ghi vào thư mục build; phần còn lại của hệ thống để chỉ-đọc.
ReadWritePaths=/var/www/xemphim/realtime/dist

StandardOutput=journal
StandardError=journal
SyslogIdentifier=xemphim-realtime

[Install]
WantedBy=multi-user.target
